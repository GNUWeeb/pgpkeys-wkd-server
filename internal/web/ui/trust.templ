package ui

import (
	"fmt"
	"time"
)

// TrustLink is another member's key linked to the member's keys by
// certifications in one direction.
type TrustLink struct {
	Fingerprint string
	// Addresses are the addresses the other key is stored for.
	Addresses []MemberAddress
	// UserIDs are the certified User IDs, on whichever key was certified.
	UserIDs []string
	// Certified is when the latest of these certifications was made.
	Certified time.Time
}

// CertRequest is a submitted certification that waits for the owner of
// the certified key.
type CertRequest struct {
	ID int64
	// Members are the other side's addresses: the submitter of a request
	// that waits for the member, the key's owner for one the member sent.
	Members []MemberAddress
	// Fingerprint is the other side's key: the certifying key, or the
	// certified one.
	Fingerprint string
	UserID      string
	Created     time.Time
}

// TrustView is what the web of trust page shows: the members whose keys
// certified the member's keys (In, plus Others by keys not in the
// directory), those whose keys the member's keys certified (Out), and the
// submitted certifications that wait for the member (Waiting) or that the
// member sent (Sent).
type TrustView struct {
	In, Out       []TrustLink
	Others        int
	Waiting, Sent []CertRequest
	// Root is the member's chain from the root key, nil when no root key
	// is set.
	Root *RootPath
}

// Trust shows the members linked to the member by certifications and the
// certifications that wait for approval.
templ Trust(p Page, v TrustView, f Flash) {
	@Layout(p) {
		<header class="page-head">
			<h1>Web of trust</h1>
			<a class="btn btn-primary" href="/trust/certify">Submit a certification</a>
		</header>
		@flash(f)
		if len(v.Waiting) > 0 {
			<section class="trust" aria-labelledby="trust-waiting">
				<h2 id="trust-waiting">Waiting for your approval</h2>
				@requestTable(p, v.Waiting, "Certifying key", true)
			</section>
		}
		if v.Root != nil {
			@rootPath(v.Root)
		}
		<section class="trust" aria-labelledby="trust-in">
			<h2 id="trust-in">Certified your keys</h2>
			if len(v.In) == 0 {
				<p class="muted">None yet.</p>
			} else {
				@trustTable(v.In)
			}
			if v.Others == 1 {
				<p class="certs">And 1 key not in this directory</p>
			} else if v.Others > 1 {
				<p class="certs">And { fmt.Sprint(v.Others) } keys not in this directory</p>
			}
		</section>
		<section class="trust" aria-labelledby="trust-out">
			<h2 id="trust-out">Certified by your keys</h2>
			if len(v.Out) == 0 {
				<p class="muted">None yet.</p>
			} else {
				@trustTable(v.Out)
			}
		</section>
		if len(v.Sent) > 0 {
			<section class="trust" aria-labelledby="trust-sent">
				<h2 id="trust-sent">Sent, waiting for approval</h2>
				@requestTable(p, v.Sent, "Certified key", false)
			</section>
		}
	}
}

// requestTable lists certification requests, with Accept and Reject for
// those that wait for the member (incoming) and Withdraw for the others.
templ requestTable(p Page, reqs []CertRequest, keyHeading string, incoming bool) {
	<div class="tbl-wrap">
		<table class="tbl">
			<thead>
				<tr>
					<th scope="col">Member</th>
					<th scope="col">{ keyHeading }</th>
					<th scope="col">User ID</th>
					<th scope="col">Certified</th>
					<th scope="col"><span class="sr-only">Actions</span></th>
				</tr>
			</thead>
			<tbody>
				for _, c := range reqs {
					<tr>
						<td>
							@memberAddresses(c.Members)
						</td>
						<td><code class="fpr">{ groupFingerprint(c.Fingerprint) }</code></td>
						<td>{ c.UserID }</td>
						<td><time datetime={ c.Created.UTC().Format(time.RFC3339) }>{ date(c.Created) }</time></td>
						<td class="actions-cell">
							<div class="actions">
								if incoming {
									@requestButton(p, c.ID, "accept", "Accept", "btn btn-primary")
									@requestButton(p, c.ID, "reject", "Reject", "btn btn-danger")
								} else {
									@requestButton(p, c.ID, "withdraw", "Withdraw", "btn btn-danger")
								}
							</div>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ requestButton(p Page, id int64, action, label, class string) {
	<form method="post" action={ templ.SafeURL(fmt.Sprintf("/trust/requests/%d/%s", id, action)) }>
		@CSRFField(p.CSRF)
		<button type="submit" class={ class }>{ label }</button>
	</form>
}

// SignTarget is the member a "Sign this key" page is about.
type SignTarget struct {
	Name, Address, URL string
	// Keys are the fingerprints of their keys that can be certified:
	// neither expired nor revoked.
	Keys []string
	// Own are the fingerprints of the viewer's stored keys; only their
	// certifications are taken.
	Own []string
}

// Certify is the form for submitting a certification; pasted and errText
// refill it after an error. With a target it is that member's "Sign this
// key" page: the GnuPG commands for their keys come first.
templ Certify(p Page, target *SignTarget, pasted, errText string, maxKiB int) {
	@Layout(p) {
		<header class="page-head">
			if target != nil {
				<div>
					<h1>{ p.Title }</h1>
					<p class="muted">{ target.Address }</p>
				</div>
			} else {
				<h1>Submit a certification</h1>
			}
		</header>
		if errText != "" {
			<div class="flash danger" role="alert">
				<p>{ errText }</p>
			</div>
		}
		if target != nil && len(target.Keys) == 0 {
			<div class="empty">
				<p class="empty-title">No key to sign</p>
				<p class="muted">Their keys have expired or are revoked.</p>
				<a class="btn" href={ templ.URL(target.URL) }>Back</a>
			</div>
		} else {
			if target != nil {
				@signSteps(*target)
			}
			<form method="post" action="/trust/certify" enctype="multipart/form-data" class="card stack">
				@CSRFField(p.CSRF)
				if target != nil {
					<input type="hidden" name="member" value={ target.Address }/>
				}
				<label class="field">
					<span>Paste the key you certified</span>
					<textarea name="key" rows="12" spellcheck="false" placeholder="-----BEGIN PGP PUBLIC KEY BLOCK-----">{ pasted }</textarea>
					if target == nil {
						<small class="muted">Certify it with <code>gpg --sign-key their@gnuweeb.org</code>, then export it with <code>gpg --armor --export their@gnuweeb.org</code>.</small>
					}
				</label>
				<label class="field">
					<span>Or choose a file</span>
					<input type="file" name="file" accept=".asc,.gpg,.pgp,.key,application/pgp-keys"/>
					<small class="muted">Up to { maxKiB } KiB.</small>
				</label>
				<div class="actions">
					<button type="submit" class="btn btn-primary">Submit</button>
					if target != nil {
						<a class="btn" href={ templ.URL(target.URL) }>Cancel</a>
					} else {
						<a class="btn" href="/trust">Cancel</a>
					}
				</div>
			</form>
		}
	}
}

// signSteps tells how to certify the target's keys with GnuPG and get
// them into the form below.
templ signSteps(t SignTarget) {
	if len(t.Own) == 0 {
		<div class="flash danger" role="alert">
			<p>Add your own key first: only certifications made with one of your keys in the directory are taken. <a href="/keys/new">Add key</a></p>
		</div>
	}
	<ol class="card steps">
		<li>
			<p><strong>Fetch the key.</strong></p>
			@command([]string{"gpg --locate-keys " + t.Address})
		</li>
		<li>
			<p><strong>Check the fingerprint with { t.Name }</strong>, in person or on a call. Sign only if it matches:</p>
			for _, fpr := range t.Keys {
				<p><code class="fpr">{ groupFingerprint(fpr) }</code></p>
			}
		</li>
		<li>
			<p><strong>Sign it.</strong></p>
			@command(signCommands(t))
			if len(t.Own) > 1 {
				<p class="muted">GnuPG signs with your default key. To sign with another of your keys, add <code>-u</code> and its fingerprint.</p>
			}
		</li>
		<li>
			<p><strong>Export it</strong> and paste it below{ oneAtATime(t) }.</p>
			for _, fpr := range t.Keys {
				@command([]string{"gpg --armor --export " + fpr})
			}
		</li>
	</ol>
}

// signCommands certify each of the target's keys, with the viewer's key
// when they have exactly one in the directory, so GnuPG cannot pick
// another.
func signCommands(t SignTarget) []string {
	signer := ""
	if len(t.Own) == 1 {
		signer = "-u " + t.Own[0] + " "
	}
	out := make([]string, 0, len(t.Keys))
	for _, fpr := range t.Keys {
		out = append(out, "gpg "+signer+"--sign-key "+fpr)
	}
	return out
}

func oneAtATime(t SignTarget) string {
	if len(t.Keys) > 1 {
		return ", one key at a time"
	}
	return ""
}

templ trustTable(links []TrustLink) {
	<div class="tbl-wrap">
		<table class="tbl">
			<thead>
				<tr>
					<th scope="col">Member</th>
					<th scope="col">Key</th>
					<th scope="col">User IDs certified</th>
					<th scope="col">Latest</th>
				</tr>
			</thead>
			<tbody>
				for _, l := range links {
					<tr>
						<td>
							@memberAddresses(l.Addresses)
						</td>
						<td><code class="fpr">{ groupFingerprint(l.Fingerprint) }</code></td>
						<td>
							<ul class="uids">
								for _, id := range l.UserIDs {
									<li>{ id }</li>
								}
							</ul>
						</td>
						<td><time datetime={ l.Certified.UTC().Format(time.RFC3339) }>{ date(l.Certified) }</time></td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
