package ui

import (
	"fmt"
	"strings"
	"time"

	"git.gnuweeb.net/GNUWeeb/matcha/internal/keys"
)

// Flash is a one-line notice above a page's content.
type Flash struct {
	// Kind is "ok" or "danger".
	Kind string
	Text string
}

// KeyRow is one of the member's keys in the list.
type KeyRow struct {
	keys.Info
	// Certifiers maps a User ID to the members' keys that certified it.
	Certifiers map[string][]Certifier
	// Others counts certifications by keys not in the directory.
	Others int
}

// Certifier is a stored key that certified a User ID of a listed key.
type Certifier struct {
	Fingerprint string
	// Addresses are the addresses the certifying key is stored for.
	Addresses []CertifierAddress
	// Created is when it made the certification.
	Created time.Time
}

// CertifierAddress is an address a certifying key is stored for, with the
// WKD URL that serves the keys for it.
type CertifierAddress struct {
	Address string
	KeyURL  string
}

// userIDs lists a key's User IDs, each with the members' keys that
// certified it, and counts the certifications by other keys.
templ userIDs(k KeyRow) {
	<ul class="uids">
		for _, id := range k.UserIDs {
			<li>
				{ id }
				if cs := k.Certifiers[id]; len(cs) > 0 {
					<span class="certs">
						Certified by
						for i, c := range cs {
							if i > 0 {
								,
							}
							<span title={ "Key " + groupFingerprint(c.Fingerprint) + ", certified " + date(c.Created) }>
								for j, a := range c.Addresses {
									if j > 0 {
										,
									}
									<a href={ templ.URL(a.KeyURL) }>{ a.Address }</a>
								}
							</span>
						}
					</span>
				}
			</li>
		}
	</ul>
	if k.Others == 1 {
		<p class="certs">Also certified by 1 key not in this directory</p>
	} else if k.Others > 1 {
		<p class="certs">Also certified by { fmt.Sprint(k.Others) } keys not in this directory</p>
	}
}

// groupFingerprint writes a fingerprint in groups of four, as gpg does.
func groupFingerprint(fpr string) string {
	var b strings.Builder
	for i := 0; i < len(fpr); i += 4 {
		if i > 0 {
			b.WriteByte(' ')
		}
		b.WriteString(fpr[i:min(i+4, len(fpr))])
	}
	return b.String()
}

func date(t time.Time) string { return t.UTC().Format("2006-01-02") }

templ flash(f Flash) {
	if f.Text != "" {
		<div class={ "flash", f.Kind } role="status">{ f.Text }</div>
	}
}

templ keyStatus(k keys.Info) {
	switch {
		case k.Revoked:
			<span class="badge danger">Revoked</span>
		case k.Expired:
			<span class="badge warn">Expired</span>
		case !k.Health.Usable:
			<span class="badge danger">Cannot sign</span>
		case hasSevere(k.Health):
			<span class="badge warn">Signing ends soon</span>
		default:
			<span class="badge ok">Valid</span>
	}
}

func hasSevere(h keys.Health) bool {
	for _, p := range h.Problems {
		if p.Severe {
			return true
		}
	}
	return false
}

// problem says what is wrong with a key and how to fix it.
templ problem(p keys.Problem) {
	<p><strong>{ p.Text }</strong> { p.Fix }</p>
	if len(p.Commands) > 0 {
		<pre class="cmd"><code>{ strings.Join(p.Commands, "\n") }</code></pre>
	}
}

// fixes lists, per key, what its owner should fix.
templ fixes(list []KeyRow) {
	<section class="fixes" aria-labelledby="fixes-title">
		<h2 id="fixes-title">What to fix</h2>
		for _, k := range list {
			if len(k.Health.Problems) > 0 {
				<article class={ "notice", templ.KV("danger", hasSevere(k.Health)) }>
					<p class="notice-key"><code class="fpr">{ groupFingerprint(k.Fingerprint) }</code></p>
					for _, p := range k.Health.Problems {
						@problem(p)
					}
				</article>
			}
		}
	</section>
}

func anyProblems(list []KeyRow) bool {
	for _, k := range list {
		if len(k.Health.Problems) > 0 {
			return true
		}
	}
	return false
}

// Keys lists the member's keys, newest first, as WKD serves them.
templ Keys(p Page, list []KeyRow, f Flash, wkdURL string) {
	@Layout(p) {
		<header class="page-head">
			<div>
				<h1>Your keys</h1>
				<p class="muted">Keys published for <b>{ p.Address }</b> through Web Key Directory.</p>
			</div>
			<a class="btn btn-primary" href="/keys/new">Add key</a>
		</header>
		@flash(f)
		if len(list) == 0 {
			<div class="empty">
				<p class="empty-title">No keys yet</p>
				<p>Add your public key, and <code>gpg --locate-keys { p.Address }</code> will find it.</p>
				<a class="btn btn-primary" href="/keys/new">Add key</a>
			</div>
		} else {
			<div class="tbl-wrap">
				<table class="tbl">
					<thead>
						<tr>
							<th scope="col">Key</th>
							<th scope="col">User IDs</th>
							<th scope="col">Created</th>
							<th scope="col">Expires</th>
							<th scope="col">Status</th>
							<th scope="col"><span class="sr-only">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						for _, k := range list {
							<tr>
								<td><code class="fpr">{ groupFingerprint(k.Fingerprint) }</code></td>
								<td>
									@userIDs(k)
								</td>
								<td><time datetime={ k.Created.UTC().Format(time.RFC3339) }>{ date(k.Created) }</time></td>
								<td>
									if k.Expires.IsZero() {
										<span class="muted">Never</span>
									} else {
										<time datetime={ k.Expires.UTC().Format(time.RFC3339) }>{ date(k.Expires) }</time>
									}
								</td>
								<td>
									@keyStatus(k.Info)
								</td>
								<td class="actions-cell">
									<a class="btn btn-danger" href={ templ.SafeURL("/keys/" + k.Fingerprint + "/remove") }>Remove</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			if anyProblems(list) {
				@fixes(list)
			}
			<p class="muted">Clients fetch these keys from <code>{ wkdURL }</code>. Certifications by other keys are kept here but not published there. A key counts as usable while one of its keys may sign under the rules kernel.org applies; a reminder comes by mail 30, 10 and 3 days before that ends.</p>
		}
	}
}

// AddKey is the upload form; pasted and errText refill it after an
// error, and fix, when not nil, explains how to repair the key.
templ AddKey(p Page, pasted, errText string, fix *keys.Problem, maxKiB int) {
	@Layout(p) {
		<header class="page-head">
			<div>
				<h1>Add key</h1>
				<p class="muted">The key needs a User ID with <b>{ p.Address }</b>. Uploading a key again replaces it, for example after you extended its expiry.</p>
			</div>
		</header>
		if errText != "" {
			<div class="flash danger" role="alert">
				<p>{ errText }</p>
				if fix != nil {
					<p>{ fix.Fix }</p>
					if len(fix.Commands) > 0 {
						<pre class="cmd"><code>{ strings.Join(fix.Commands, "\n") }</code></pre>
					}
				}
			</div>
		}
		<form method="post" action="/keys" enctype="multipart/form-data" class="card stack">
			@CSRFField(p.CSRF)
			<label class="field">
				<span>Paste the public key</span>
				<textarea name="key" rows="12" spellcheck="false" placeholder="-----BEGIN PGP PUBLIC KEY BLOCK-----">{ pasted }</textarea>
				<small class="muted">Output of <code>gpg --armor --export { p.Address }</code>.</small>
			</label>
			<label class="field">
				<span>Or choose a file</span>
				<input type="file" name="file" accept=".asc,.gpg,.pgp,.key,application/pgp-keys"/>
				<small class="muted">Armored or binary, up to { maxKiB } KiB.</small>
			</label>
			<div class="actions">
				<button type="submit" class="btn btn-primary">Add key</button>
				<a class="btn" href="/">Cancel</a>
			</div>
		</form>
	}
}

// RemoveKey asks before a key is removed.
templ RemoveKey(p Page, k keys.Info) {
	@Layout(p) {
		<section class="card">
			<h1>Remove key?</h1>
			<p>WKD stops serving this key for <b>{ p.Address }</b> at once. Copies that others already fetched stay with them.</p>
			<p><code class="fpr">{ groupFingerprint(k.Fingerprint) }</code></p>
			<ul class="uids">
				for _, id := range k.UserIDs {
					<li>{ id }</li>
				}
			</ul>
			<form method="post" action={ templ.SafeURL("/keys/" + k.Fingerprint + "/remove") } class="actions">
				@CSRFField(p.CSRF)
				<button type="submit" class="btn btn-danger-solid">Remove key</button>
				<a class="btn" href="/">Cancel</a>
			</form>
		</section>
	}
}
