# Settings with a default are shown commented out; uncomment to change
# them. This file holds the SMTP password once filled in: keep it out of
# git (.gitignore lists .env) and readable only by its owner.

# Listen address of the WKD routes (/.well-known/openpgpkey/...). Only the
# nginx in front of the mail domain should reach it. The Docker image sets
# :8080 instead, so leave this commented out there.
#WKD_ADDR=127.0.0.1:8080

# Listen address of the dashboard. The Docker image sets :8081 instead.
#DASHBOARD_ADDR=127.0.0.1:8081

# SQLite database file, created if missing. The Docker image sets
# /var/lib/matcha/matcha.db, on the image's volume.
#DATABASE_PATH=matcha.db

# The mail domain whose members log in and whose keys WKD serves.
#EMAIL_DOMAIN=gnuweeb.org

# Public URL of the dashboard; login links in mails point below it.
#BASE_URL=https://pgp.gnuweeb.org

# Header that carries the client's address when a reverse proxy sits in
# front of the dashboard; the per-client rate limit counts by it. Set it
# only when the proxy always sets (overwrites) this header.
#REAL_IP_HEADER=X-Real-IP

# Members' photos from Gravatar on their dashboard pages: on or off. The
# server fetches them (never the browser), so Gravatar learns the
# SHA-256 of each member address looked up.
#GRAVATAR=on

# SMTP server for the login mails (required). SMTP_TLS is one of
# starttls (default port 587), implicit (default port 465) or none (only
# for a local mail catcher). Leave the username and password empty for a
# server without authentication.
SMTP_HOST=
#SMTP_PORT=587
#SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# Sender of the login mails, a bare address. Defaults to pgp@EMAIL_DOMAIN.
#MAIL_FROM=pgp@gnuweeb.org
